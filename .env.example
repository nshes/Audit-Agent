# Audit Agent 환경변수 설정 파일
# agent.yaml의 env.required 항목과 동일합니다.
# 사용법: cp .env.example .env  후 실제 값 입력

# [필수] Upstage Solar LLM API 키 (/invoke 엔드포인트 실행에 필요)
# 발급: https://console.upstage.ai
UPSTAGE_API_KEY=your_upstage_api_key_here

# [필수] 오케스트레이터 API 기본 주소 (Active Pull 방식으로 공통 JSON 조회에 사용)
# Audit Agent는 아래 두 엔드포인트를 내부적으로 호출합니다:
#   GET  {ORCHESTRATOR_BASE_URL}/upstageknu2607/db/workflows/{report_id}
#   POST {ORCHESTRATOR_BASE_URL}/upstageknu2607/db/workflows/{report_id}/agents/audit_agent/invocations
ORCHESTRATOR_BASE_URL=https://api.mingyo.kim

# [선택] 오케스트레이터 API 인증 토큰 (인증이 필요한 경우)
# 설정 시 "Authorization: Bearer {token}" 헤더로 전송됩니다
# ORCHESTRATOR_API_KEY=your_orchestrator_api_key_here
